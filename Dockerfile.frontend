FROM node:26-alpine AS builder
WORKDIR /app

RUN apk add --no-cache openssl libc6-compat

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# DATABASE_URL solo se necesita en build para que prisma generate funcione
# No queda en la imagen final (solo el builder stage la usa)
ARG DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy?schema=public"
ENV DATABASE_URL=$DATABASE_URL

RUN npx prisma generate
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ---- Etapa 2: tests (ejecuta suite con umbral y coverage) ----
FROM builder AS test
ENTRYPOINT ["npm", "run", "test:frontend:ci"]

FROM node:26-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl libc6-compat
RUN npm install --no-package-lock sharp

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# El frontend NO accede a la BD en runtime — no tiene DATABASE_URL
# Prisma client no se copia al runner

# El commit que produjo esta imagen: lo pasa el pipeline (build-args) y /api/health lo devuelve.
# Va al final del runner para no invalidar la caché de las capas de arriba.
ARG GIT_COMMIT=desconocido
ENV GIT_COMMIT=$GIT_COMMIT

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
