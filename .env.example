# =====================================================
# Plantilla de variables de entorno
# Copiá este archivo a .env y completá los valores
# =====================================================

# ┌─────────────────────────────────────────────────┐
# │  SERVICIO: reservas-db (PostgreSQL)             │
# └─────────────────────────────────────────────────┘
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=reservasdb

# ┌─────────────────────────────────────────────────┐
# │  SERVICIO: reservas-backend                     │
# │  ⚠️  DATABASE_URL y GEO_API_KEY son EXCLUSIVOS   │
# │     del backend. NO pasar al frontend.          │
# └─────────────────────────────────────────────────┘
# En Docker Compose el host es el nombre del servicio (reservas-db)
# Para desarrollo local sin Docker, usar localhost:5434
DATABASE_URL=postgresql://postgres:tu_password_segura@reservas-db:5432/reservasdb?schema=public

# URL pública del backend (usada en NEXTAUTH_URL del backend)
NEXTAUTH_URL_BACKEND=http://localhost:4000

# APIs externas (solo backend)
GEO_API_KEY=tu_api_key

# ┌─────────────────────────────────────────────────┐
# │  COMPARTIDAS: frontend + backend                │
# └─────────────────────────────────────────────────┘

# Puertos
BACKEND_PORT=4000
FRONTEND_PORT=3000

# URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_URL=http://reservas-backend:4000

# Auth — ambos servicios deben usar el MISMO secret
# para que la sesión JWT funcione correctamente
AUTH_SECRET=generar_un_secreto_seguro_con_openssl_rand_base64_32
NEXTAUTH_SECRET=generar_un_secreto_seguro_con_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# API Key interna para comunicación frontend → backend
# Generar con: openssl rand -hex 32
BACKEND_API_KEY=generar_api_key_interna_segura
